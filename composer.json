{
    "name": "mirror-and-mountain/meros-foundations",
    "description": "A lean Laravel-in-WordPress integration layer for the Meros framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/pipeline": "^13.0",
        "illuminate/view": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/validation": "^13.0",
        "livewire/livewire": "^4.4.8",
        "symfony/uid": "^8.1.9",
        "vlucas/phpdotenv": "^5.6",
        "illuminate/session": "^13.0",
        "illuminate/cookie": "^13.0",
        "illuminate/console": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "MM\\Meros\\Foundations\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MM\\Meros\\Foundations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}